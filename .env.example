# ─────────────────────────────────────────────────────────────────────────────
# Template file – safe to commit.
# Copy this to .env and fill in your real values for local development.
# For GitHub Actions, add each key as a Secret in:
#   Repo → Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────────────────────

# Telegram credentials (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email credentials (optional; not used in market-alert-only mode)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Execution window (required, HH:MM, in DISPLAY_TIMEZONE)
EXECUTION_START_TIME=09:00
EXECUTION_STOP_TIME=15:30

# Alert window (required, HH:MM, in DISPLAY_TIMEZONE)
ALERT_WINDOW_START_TIME=09:00
ALERT_WINDOW_END_TIME=15:30
ALERT_INTERVAL_MINUTES=60

# Timezone used for all schedule comparisons and message timestamps (required)
DISPLAY_TIMEZONE=Asia/Kolkata

# Message templates (optional)
STARTUP_SIGNAL_TEMPLATE=✅ Startup scheduled at {scheduled_slot_timestamp} | sent at {actual_run_time}
ALERT_MESSAGE_TEMPLATE=📈 Market alert | scheduled: {scheduled_slot_timestamp} | sent: {actual_run_time}
SUMMARY_SUBJECT_TEMPLATE=Daily Alert Summary - {date}

# Manual test mode (optional)
MANUAL_TEST_MODE=false
MANUAL_TEST_MESSAGE_TEMPLATE=🧪 Manual test signal at {timestamp} (window checks bypassed)

# Run-start notification mode (optional)
NOTIFY_ON_EACH_RUN_START=false
RUN_START_MESSAGE_TEMPLATE=🚀 Info: started Git-Actions at {timestamp}

# Schedule tolerance (required)
# App runs every 15 minutes; keep this <= 14 to avoid duplicate slot sends.
SLOT_TOLERANCE_MINUTES=14

# Max catch-up delay in minutes (optional)
# Keep equal to SLOT_TOLERANCE_MINUTES for market-alert-only mode.
MAX_CATCHUP_MINUTES=14

# Local runtime mode (optional; ignored by GitHub schedule)
LOCAL_CONTINUOUS_MODE=false
LOCAL_LOOP_SLEEP_SECONDS=5


